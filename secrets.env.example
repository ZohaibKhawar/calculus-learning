# Copy this file to secrets.env (same folder) and fill in the values.
# secrets.env is git-ignored: never commit real keys.

# Google sign-in: OAuth client ID from Google Cloud Console (APIs & Services > Credentials).
# Authorized JavaScript origin: https://zohi29.pythonanywhere.com (and http://localhost:5000 for testing)
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile (free bot check): dash.cloudflare.com > Turnstile > Add site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Usernames (comma-separated) that can delete any forum post and block accounts.
ADMIN_USERS=
