# Copy this file to secrets.env (same folder) and fill in the values.
# secrets.env is git-ignored: never commit real keys.

# Moderator passcode, at least 12 characters. Open /#/admin on the site and enter it to
# let that browser see reported posts, delete any forum post and block people.
ADMIN_KEY=

# Optional. To see how the site does on Google, add it at https://search.google.com/search-console,
# choose the "HTML tag" way to verify, and paste only the code inside content="..." here.
GOOGLE_SITE_VERIFICATION=
